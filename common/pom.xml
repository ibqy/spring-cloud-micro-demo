<?xml version="1.0" encoding="UTF-8"?>
<!--
  ============================================================
  common —— 公共模块（DTO、API 接口）
  作者：xb  |  日期：2026-09-12
  说明：存放所有微服务共享的 DTO 类和 OpenFeign 接口定义，
        其他模块通过引入此模块实现类型安全的服务间调用。
  ============================================================
-->
<project xmlns="http://www.w3.org/2001/XMLSchema-instance"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.xb</groupId>
        <artifactId>spring-cloud-micro-demo</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>common</artifactId>
    <packaging>jar</packaging>

    <dependencies>
        <!-- Web（仅需要 web 注解支持） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!-- OpenFeign 接口注解 -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-openfeign</artifactId>
        </dependency>
    </dependencies>
</project>