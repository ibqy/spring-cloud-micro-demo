<?xml version="1.0" encoding="UTF-8"?>
<!--
  ============================================================
  gateway-service —— Spring Cloud Gateway 网关
  作者：xb  |  日期：2026-09-12
  说明：微服务统一入口网关，演示路由转发、过滤器链、负载均衡。
        所有外部请求经网关转发到 user-service / order-service。
  ============================================================
-->
<project xmlns="http://www.w3.org/2001/XMLSchema-instance"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.xb</groupId>
        <artifactId>spring-cloud-micro-demo</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>gateway-service</artifactId>
    <packaging>jar</packaging>

    <dependencies>
        <!-- Gateway（基于 WebFlux，不引入 spring-boot-starter-web） -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-gateway</artifactId>
        </dependency>

        <!-- Redis Reactive：为 RequestRateLimiter 提供 Redis 后端 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis-reactive</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
